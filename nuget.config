<?xml version="1.0" encoding="utf-8"?>
<!--
  ERPSEP-05 / ADR-067: platform modules are consumed as VERSIONED PACKAGES, never through a
  relative ProjectReference into the platform repository. This module lives in its own repo,
  so the shared hosting contract can only arrive this way.

  The credential is read from the SPACEOS_PACKAGES_TOKEN environment variable; no token is
  ever committed. Locally:  $env:SPACEOS_PACKAGES_TOKEN = (gh auth token)
  In CI: a repository secret with read:packages scope. GitHub Packages requires
  authentication even for PUBLIC packages, so the workflow cannot rely on anonymous restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="spaceos-github" value="https://nuget.pkg.github.com/Szantoi/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Only SpaceOS packages may come from the private feed; everything else must come from
    nuget.org. This blocks a dependency confusion substitution of a public package name.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="spaceos-github">
      <package pattern="SpaceOS.*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <spaceos-github>
      <add key="Username" value="Szantoi" />
      <add key="ClearTextPassword" value="%SPACEOS_PACKAGES_TOKEN%" />
    </spaceos-github>
  </packageSourceCredentials>
</configuration>
