<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SpaceOS.Modules.Scheduling.Infrastructure\SpaceOS.Modules.Scheduling.Infrastructure.csproj" />

    <!-- The solver scenario builders live in the Domain test assembly. Materialisation is
         measured on plans a REAL strategy produced, not on hand-written ones: a hand-built
         plan could satisfy the calendar by accident and would stop being evidence. -->
    <ProjectReference Include="..\SpaceOS.Modules.Scheduling.Domain.Tests\SpaceOS.Modules.Scheduling.Domain.Tests.csproj" />
  </ItemGroup>

</Project>
