<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning that survives is a warning nobody reads. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <NeutralLanguage>en</NeutralLanguage>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- ADR-070 supply-chain requirement: every restore is pinned by a committed lockfile.
         Without it a floating transitive dependency can change under a green CI, and for a
         module that will ship native binaries (OR-Tools) the bundle digest would move with
         it. CI restores in locked mode, so an unintended version bump fails the build
         instead of landing silently. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Public API of the shipped library must be documented; test methods are named as
       sentences and would only gain noise from XML comments.
       The condition is on the project NAME, not on $(IsTestProject): this file is
       imported before the test project sets that property, so it would always be empty. -->
  <!-- 'Tests', not '.Tests': IntegrationTests would otherwise slip through and demand
       XML comments on every fact. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
